{
  "name": "grimoire",
  "version": "0.1.0",
  "description": "A spell book for shell commands - browse, search, and annotate your command history",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "grimoire": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "shell",
    "history",
    "command",
    "terminal",
    "tui",
    "annotations"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.0.0",
    "clipboardy": "^5.0.2",
    "commander": "^12.0.0",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
